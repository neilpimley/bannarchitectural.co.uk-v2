---
layout: base.njk
title: Contact
permalink: /contact/
---
<section class="page-hero compact">
  <p class="eyebrow">Contact</p>
  <h1>Talk to Bann Architectural Systems</h1>
</section>
<section class="contact-page">
  <div>
    <h2>Contact details</h2>
    <p>Please email us with your contact name and telephone number and we will get back to you.</p>
    <div class="contact-actions">
      <a class="button" href="mailto:{{ site.email }}">{{ site.email }}</a>
      <a class="button secondary" href="tel:{{ site.phone | replace(' ', '') }}">{{ site.phone }}</a>
    </div>
  </div>
  <address>
    <strong>{{ site.address.company }}</strong>
    {% for line in site.address.lines %}<span>{{ line }}</span>{% endfor %}
  </address>
</section>
