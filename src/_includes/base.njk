<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ site.description }}">
    <title>{{ title or site.title }} | {{ site.title }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Dosis:wght@400;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/assets/styles.css">
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="{{ site.title }} home">
          <span class="brand-mark">B</span>
          <span><strong>Bann</strong><small>Architectural Systems</small></span>
        </a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
          <span></span><span></span><span></span>
        </button>
        <nav id="site-nav" class="site-nav" aria-label="Main navigation">
          <a href="/about/">About</a>
          <a href="/products/">Products</a>
          <a href="/projects/">Projects</a>
          <a href="/contact/">Contact</a>
        </nav>
        <a class="phone-link" href="tel:{{ site.phone | replace(' ', '') }}">{{ site.phone }}</a>
      </div>
    </header>
    <main>{{ content | safe }}</main>
    <footer class="site-footer">
      <div>
        <h2>{{ site.title }}</h2>
        <p>{{ site.description }}</p>
      </div>
      <address>
        <strong>{{ site.address.company }}</strong>
        {% for line in site.address.lines %}<span>{{ line }}</span>{% endfor %}
        <a href="tel:{{ site.phone | replace(' ', '') }}">Tel: {{ site.phone }}</a>
        <a href="mailto:{{ site.email }}">{{ site.email }}</a>
      </address>
      <div class="footer-products">
        <strong>Products</strong>
        {% for product in products.items %}
          <a href="/products/#{{ product.slug }}">{{ product.title }}</a>
        {% endfor %}
      </div>
    </footer>
    <script src="/assets/site.js"></script>
  </body>
</html>
