---
layout: base.njk
title: Projects
permalink: /projects/
---
<section class="page-hero compact">
  <p class="eyebrow">Projects</p>
  <h1>Recent commercial and residential glazing projects</h1>
</section>
<section class="projects-page">
  {% for project in projects.items %}
    <a class="project-card project-list-card" href="/projects/{{ project.slug }}/">
      <img src="{{ project.image }}" alt="{{ project.title }}">
      <div>
        <span>{{ project.category }}</span>
        <h2>{{ project.title }}</h2>
        <p>{{ project.summary }}</p>
        <dl class="project-meta">
          {% if project.builder %}
            <div>
              <dt>Builder</dt>
              <dd>{{ project.builder }}</dd>
            </div>
          {% endif %}
          {% if project.architect %}
            <div>
              <dt>Architect</dt>
              <dd>{{ project.architect }}</dd>
            </div>
          {% endif %}
        </dl>
      </div>
    </a>
  {% endfor %}
</section>
